                      <HierarchyName>OrganisationName</HierarchyName>
                      <HierarchyUniqueName>[Dim Organisation].[OrganisationName]</HierarchyUniqueName>
                      <LevelName>OrganisationName</LevelName>
                      <UniqueName>[Dim Organisation].[OrganisationName].[OrganisationName]</UniqueName>
                    </ID>
                    <ItemCaption>OrganisationName</ItemCaption>
                    <UniqueName>true</UniqueName>
                  </Item>
                </Items>
              </Select>
              <AutoExecute>false</AutoExecute>
              <From>Model</From>
              <Filter>
                <FilterItems />
              </Filter>
