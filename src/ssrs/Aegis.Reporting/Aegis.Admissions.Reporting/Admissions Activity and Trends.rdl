    <DataSet Name="DS_Organisation_Site_Activity">
      <Query>
        <DataSourceName>DS_Aegis_Admissions_Analysis</DataSourceName>
        <CommandText>EVALUATE
SUMMARIZECOLUMNS(
    'Dim Organisation'[OrganisationName],
    'Dim Site'[SiteName],
    "Admissions", [Admissions],
    "Open Admissions", [Open Admissions],
    "Discharged Admissions", [Discharged Admissions],
    "Distinct Patients", [Distinct Patients]
)
ORDER BY
    'Dim Organisation'[OrganisationName],
    'Dim Site'[SiteName]</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
            <CommandType>DAX</CommandType>
            <QuerySpecification xsi:type="MDXQuerySpecification">
              <Select>
                <Items>
                  <Item>
                    <ID xsi:type="Level">
                      <DimensionName>Dim Organisation</DimensionName>
                      <HierarchyName>OrganisationName</HierarchyName>
                      <HierarchyUniqueName>[Dim Organisation].[OrganisationName]</HierarchyUniqueName>
                      <LevelName>OrganisationName</LevelName>
                      <UniqueName>[Dim Organisation].[OrganisationName].[OrganisationName]</UniqueName>
                    </ID>
                    <ItemCaption>OrganisationName</ItemCaption>
                    <UniqueName>true</UniqueName>
                  </Item>
                  <Item>
                    <ID xsi:type="Level">
                      <DimensionName>Dim Site</DimensionName>
                      <HierarchyName>SiteName</HierarchyName>
                      <HierarchyUniqueName>[Dim Site].[SiteName]</HierarchyUniqueName>
                      <LevelName>SiteName</LevelName>
                      <UniqueName>[Dim Site].[SiteName].[SiteName]</UniqueName>
                    </ID>
                    <ItemCaption>SiteName</ItemCaption>
                    <UniqueName>true</UniqueName>
                  </Item>
                  <Item>
                    <ID xsi:type="Measure">
                      <MeasureName>Admissions</MeasureName>
                      <UniqueName>[Measures].[Admissions]</UniqueName>
                    </ID>
                    <ItemCaption>Admissions</ItemCaption>
                    <BackColor>true</BackColor>
                    <ForeColor>true</ForeColor>
                    <FontFamily>true</FontFamily>
                    <FontSize>true</FontSize>
                    <FontWeight>true</FontWeight>
                    <FontStyle>true</FontStyle>
                    <FontDecoration>true</FontDecoration>
                    <FormattedValue>true</FormattedValue>
                    <FormatString>true</FormatString>
                  </Item>
                  <Item>
                    <ID xsi:type="Measure">
                      <MeasureName>Open Admissions</MeasureName>
                      <UniqueName>[Measures].[Open Admissions]</UniqueName>
                    </ID>
                    <ItemCaption>Open Admissions</ItemCaption>
                    <BackColor>true</BackColor>
                    <ForeColor>true</ForeColor>
                    <FontFamily>true</FontFamily>
                    <FontSize>true</FontSize>
                    <FontWeight>true</FontWeight>
                    <FontStyle>true</FontStyle>
                    <FontDecoration>true</FontDecoration>
                    <FormattedValue>true</FormattedValue>
                    <FormatString>true</FormatString>
                  </Item>
                  <Item>
                    <ID xsi:type="Measure">
                      <MeasureName>Discharged Admissions</MeasureName>
                      <UniqueName>[Measures].[Discharged Admissions]</UniqueName>
                    </ID>
                    <ItemCaption>Discharged Admissions</ItemCaption>
                    <BackColor>true</BackColor>
                    <ForeColor>true</ForeColor>
                    <FontFamily>true</FontFamily>
                    <FontSize>true</FontSize>
                    <FontWeight>true</FontWeight>
                    <FontStyle>true</FontStyle>
                    <FontDecoration>true</FontDecoration>
                    <FormattedValue>true</FormattedValue>
                    <FormatString>true</FormatString>
                  </Item>
                  <Item>
                    <ID xsi:type="Measure">
                      <MeasureName>Distinct Patients</MeasureName>
                      <UniqueName>[Measures].[Distinct Patients]</UniqueName>
                    </ID>
                    <ItemCaption>Distinct Patients</ItemCaption>
                    <BackColor>true</BackColor>
                    <ForeColor>true</ForeColor>
                    <FontFamily>true</FontFamily>
                    <FontSize>true</FontSize>
                    <FontWeight>true</FontWeight>
                    <FontStyle>true</FontStyle>
                    <FontDecoration>true</FontDecoration>
                    <FormattedValue>true</FormattedValue>
                    <FormatString>true</FormatString>
                  </Item>
                </Items>
              </Select>
              <AutoExecute>false</AutoExecute>
              <From>Model</From>
              <Filter>
                <FilterItems>
                  <FilterItem>
                    <HierarchyUniqueName>[Dim Organisation].[OrganisationName]</HierarchyUniqueName>
                    <Condition xsi:type="EqualTo">
                      <Members />
                      <Parametrized>true</Parametrized>
                    </Condition>
                  </FilterItem>
                </FilterItems>
              </Filter>
              <Calculations />
              <Aggregates />
              <QueryProperties>
                <IncludeMemberValue>true</IncludeMemberValue>
              </QueryProperties>
            </QuerySpecification>
            <Query>
              <Statement>DEFINE VAR vDimOrganisationOrganisationName1 = IF(PATHLENGTH(@DimOrganisationOrganisationName) = 1, IF(@DimOrganisationOrganisationName &lt;&gt; "", @DimOrganisationOrganisationName, BLANK()), IF(PATHITEM(@DimOrganisationOrganisationName, 2) &lt;&gt; "", PATHITEM(@DimOrganisationOrganisationName, 2), BLANK()))
VAR vDimOrganisationOrganisationName1ALL = PATHLENGTH(@DimOrganisationOrganisationName) &gt; 1 &amp;&amp; PATHITEM(@DimOrganisationOrganisationName, 1, 1) &lt; 1
EVALUATE SUMMARIZECOLUMNS('Dim Organisation'[OrganisationName], 'Dim Site'[SiteName], FILTER(VALUES('Dim Organisation'[OrganisationName]), ((vDimOrganisationOrganisationName1ALL || 'Dim Organisation'[OrganisationName] = vDimOrganisationOrganisationName1))), "Admissions", [Admissions], "Open Admissions", [Open Admissions], "Discharged Admissions", [Discharged Admissions], "Distinct Patients", [Distinct Patients])</Statement>
              <ParameterDefinitions>
                <ParameterDefinition>
                  <Name>DimOrganisationOrganisationName</Name>
                  <DefaultValues />
                  <Caption>OrganisationName</Caption>
                  <HierarchyUniqueName>[Dim Organisation].[OrganisationName]</HierarchyUniqueName>
                  <ParameterValuesQuery>
                    <Statement>EVALUATE SELECTCOLUMNS (ADDCOLUMNS (SUMMARIZECOLUMNS (ROLLUPADDISSUBTOTAL ('Dim Organisation'[OrganisationName], "h0")), "ParameterLevel", if ([h0], 0, 1)), "ParameterCaption", SWITCH([ParameterLevel], 1, 'Dim Organisation'[OrganisationName], "All"), "ParameterValue", [ParameterLevel] &amp; "|" &amp; 'Dim Organisation'[OrganisationName], "ParameterLevel", [ParameterLevel], "'Dim Organisation'[OrganisationName]", 'Dim Organisation'[OrganisationName]) order by 'Dim Organisation'[OrganisationName], [ParameterLevel]</Statement>
                    <ParameterizedStatement>
                      <ReferencedParameters />
                    </ParameterizedStatement>
                  </ParameterValuesQuery>
                  <MultipleValues>true</MultipleValues>
                  <AllowBlank>true</AllowBlank>
                </ParameterDefinition>
              </ParameterDefinitions>
            </Query>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
