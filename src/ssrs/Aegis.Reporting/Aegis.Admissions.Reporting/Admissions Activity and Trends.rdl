    <DataSet Name="DS_Monthly_Activity">
      <Query>
        <DataSourceName>DS_Aegis_Admissions_Analysis</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="OrganisationName">
            <Value>=Parameters!OrganisationName.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EVALUATE
VAR SelectedOrganisation = @OrganisationName
RETURN
CALCULATETABLE(
    SUMMARIZECOLUMNS(
        'Dim Date'[Year Month],
        "Admissions", [Admissions],
        "Discharged Admissions", [Discharged Admissions]
    ),
    FILTER(
        ALL('Dim Organisation'[OrganisationName]),
        SelectedOrganisation = "__ALL__"
            || 'Dim Organisation'[OrganisationName] = SelectedOrganisation
    )
)
ORDER BY
    'Dim Date'[Year Month]</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
