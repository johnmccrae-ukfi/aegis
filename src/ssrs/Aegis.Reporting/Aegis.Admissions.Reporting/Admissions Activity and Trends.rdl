    <DataSet Name="DS_Organisation_Parameter">
      <Query>
        <DataSourceName>DS_Aegis_Admissions_Analysis</DataSourceName>
        <CommandText>EVALUATE
UNION(
    ROW(
        "OrganisationValue", "__ALL__",
        "OrganisationLabel", "All Organisations"
    ),
    SELECTCOLUMNS(
        'Dim Organisation',
        "OrganisationValue", 'Dim Organisation'[OrganisationName],
        "OrganisationLabel", 'Dim Organisation'[OrganisationName]
    )
)
ORDER BY
    [OrganisationLabel]</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
