          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{9A90D54D-FEEE-4092-A847-BF2DB78C3E88}"
              SQLTask:SqlStatementSource="DECLARE @BatchId BIGINT = ?;&#xA;DECLARE @PackageExecutionId BIGINT = ?;&#xA;DECLARE @SsisErrorCode INT = ?;&#xA;DECLARE @ErrorDescription NVARCHAR(4000) = ?;&#xA;DECLARE @ErrorSource NVARCHAR(260) = ?;&#xA;&#xA;IF @BatchId &lt;= 0&#xA;   OR @PackageExecutionId &lt;= 0&#xA;BEGIN&#xA;    RETURN;&#xA;END;&#xA;&#xA;UPDATE [audit].[PackageExecution]&#xA;SET&#xA;    [ExecutionStatus] = 'FAILED',&#xA;    [CompletedAt] = COALESCE([CompletedAt], SYSUTCDATETIME()),&#xA;    [ErrorCode] = 'AEGIS-SSIS-RUNTIME',&#xA;    [ErrorDetail] =&#xA;        LEFT&#xA;        (&#xA;            CONCAT&#xA;            (&#xA;                N'SSIS error ',&#xA;                @SsisErrorCode,&#xA;                N' raised by ',&#xA;                COALESCE(@ErrorSource, N'unknown source'),&#xA;                N': ',&#xA;                COALESCE(@ErrorDescription, N'No error description supplied.')&#xA;            ),&#xA;            4000&#xA;        ),&#xA;    [UpdatedAt] = SYSUTCDATETIME()&#xA;WHERE [PackageExecutionId] = @PackageExecutionId&#xA;  AND [BatchId] = @BatchId&#xA;  AND [ExecutionStatus] = 'STARTED';&#xA;&#xA;UPDATE [audit].[Batch]&#xA;SET&#xA;    [BatchStatus] = 'FAILED',&#xA;    [CompletedAt] = COALESCE([CompletedAt], SYSUTCDATETIME()),&#xA;    [ErrorCode] = 'AEGIS-SSIS-RUNTIME',&#xA;    [ErrorDetail] =&#xA;        LEFT&#xA;        (&#xA;            CONCAT&#xA;            (&#xA;                N'Package execution ',&#xA;                @PackageExecutionId,&#xA;                N' failed. SSIS error ',&#xA;                @SsisErrorCode,&#xA;                N' raised by ',&#xA;                COALESCE(@ErrorSource, N'unknown source'),&#xA;                N': ',&#xA;                COALESCE(@ErrorDescription, N'No error description supplied.')&#xA;            ),&#xA;            4000&#xA;        ),&#xA;    [UpdatedAt] = SYSUTCDATETIME()&#xA;WHERE [BatchId] = @BatchId&#xA;  AND [BatchStatus] IN&#xA;  (&#xA;      'RECEIVED',&#xA;      'PROCESSING'&#xA;  );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BatchId"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="20"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
