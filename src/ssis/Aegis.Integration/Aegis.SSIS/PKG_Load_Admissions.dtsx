    <DTS:Executable
      DTS:refId="Package\SQL_Write_Record_Outcomes"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1226118C-73AE-48C3-97A1-18AC54D0661E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Write_Record_Outcomes"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9A90D54D-FEEE-4092-A847-BF2DB78C3E88}"
          SQLTask:SqlStatementSource="INSERT INTO [audit].[RecordOutcome]&#xA;(&#xA;    [BatchId],&#xA;    [PackageExecutionId],&#xA;    [SourceDomain],&#xA;    [SourceObject],&#xA;    [SourceRecordIdentifier],&#xA;    [SourceRowNumber],&#xA;    [LandingRecordId],&#xA;    [ProcessingOutcome],&#xA;    [OutcomeReasonCode],&#xA;    [OutcomeDetail],&#xA;    [ProcessedAt]&#xA;)&#xA;SELECT&#xA;    [Staging].[BatchId],&#xA;    [Staging].[PackageExecutionId],&#xA;    'PAS_ACTIVITY',&#xA;    'Admission',&#xA;    [Staging].[SourceRecordIdentifier],&#xA;    [Staging].[SourceRowNumber],&#xA;    [Staging].[LandingAdmissionId],&#xA;    [Staging].[ProcessingOutcome],&#xA;    CASE&#xA;        WHEN [Staging].[ProcessingOutcome] = 'ACCEPTED'&#xA;        THEN 'VALID_ADMISSION'&#xA;        WHEN [Staging].[ProcessingOutcome] = 'QUARANTINED'&#xA;        THEN 'VALIDATION_FAILURE'&#xA;        ELSE NULL&#xA;    END,&#xA;    CASE&#xA;        WHEN [Staging].[ProcessingOutcome] = 'ACCEPTED'&#xA;        THEN N'Admission passed all configured validation and lookup rules.'&#xA;        WHEN [Staging].[ProcessingOutcome] = 'QUARANTINED'&#xA;        THEN N'Admission failed one or more configured validation or lookup rules.'&#xA;        ELSE NULL&#xA;    END,&#xA;    SYSUTCDATETIME()&#xA;FROM [Aegis_Staging].[stg].[Admission] AS [Staging]&#xA;WHERE [Staging].[BatchId] = ?&#xA;  AND [Staging].[PackageExecutionId] = ?&#xA;  AND [Staging].[ProcessingOutcome] IS NOT NULL&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM [audit].[RecordOutcome] AS [Existing]&#xA;      WHERE [Existing].[BatchId] = [Staging].[BatchId]&#xA;        AND [Existing].[SourceDomain] = 'PAS_ACTIVITY'&#xA;        AND [Existing].[SourceObject] = 'Admission'&#xA;        AND [Existing].[SourceRecordIdentifier] =&#xA;            [Staging].[SourceRecordIdentifier]&#xA;  );&#xA;&#xA;IF @@ROWCOUNT = 0&#xA;BEGIN&#xA;    THROW 51000, 'No admission record outcomes were written.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::PackageExecutionId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
