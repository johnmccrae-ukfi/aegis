    <DTS:Executable
      DTS:refId="Package\SQL_Load_Quarantined_Admissions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{045E743A-27E6-4B2C-A507-8131913D9CDC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Load_Quarantined_Admissions"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F6208311-4AF5-4F7F-9F74-B83868D8B68C}"
          SQLTask:SqlStatementSource="INSERT INTO [quarantine].[Admission]&#xA;(&#xA;    [LandingAdmissionId],&#xA;    [StagingAdmissionId],&#xA;    [BatchId],&#xA;    [PackageExecutionId],&#xA;    [SourceSystemCode],&#xA;    [SourceFileName],&#xA;    [SourceRowNumber],&#xA;    [SourceRecordIdentifier],&#xA;    [AdmissionId],&#xA;    [PatientId],&#xA;    [OrganisationId],&#xA;    [SiteId],&#xA;    [AdmissionNumber],&#xA;    [PatientPathwayId],&#xA;    [AdmissionDateTime],&#xA;    [DischargeDateTime],&#xA;    [AdmissionMethodCode],&#xA;    [AdmissionSourceCode],&#xA;    [PatientClassificationCode],&#xA;    [IntendedManagementCode],&#xA;    [DischargeMethodCode],&#xA;    [DischargeDestinationCode],&#xA;    [AdministrativeCategoryCode],&#xA;    [LegalStatusCode],&#xA;    [AdmissionStatusCode],&#xA;    [RecordCreatedAt],&#xA;    [RecordUpdatedAt],&#xA;    [IsDeleted],&#xA;    [QuarantineReasonCode],&#xA;    [QuarantineReasonDetail],&#xA;    [ValidationFailureCount],&#xA;    [QuarantineStatus],&#xA;    [QuarantinedAt]&#xA;)&#xA;SELECT&#xA;    [Staging].[LandingAdmissionId],&#xA;    [Staging].[StagingAdmissionId],&#xA;    [Staging].[BatchId],&#xA;    [Staging].[PackageExecutionId],&#xA;    [Staging].[SourceSystemCode],&#xA;    [Landing].[SourceFileName],&#xA;    [Staging].[SourceRowNumber],&#xA;    [Staging].[SourceRecordIdentifier],&#xA;    [Staging].[AdmissionId],&#xA;    [Staging].[PatientId],&#xA;    [Staging].[OrganisationId],&#xA;    [Staging].[SiteId],&#xA;    [Staging].[AdmissionNumber],&#xA;    [Staging].[PatientPathwayId],&#xA;    [Staging].[AdmissionDateTime],&#xA;    [Staging].[DischargeDateTime],&#xA;    [Staging].[AdmissionMethodCode],&#xA;    [Staging].[AdmissionSourceCode],&#xA;    [Staging].[PatientClassificationCode],&#xA;    [Staging].[IntendedManagementCode],&#xA;    [Staging].[DischargeMethodCode],&#xA;    [Staging].[DischargeDestinationCode],&#xA;    [Staging].[AdministrativeCategoryCode],&#xA;    [Staging].[LegalStatusCode],&#xA;    [Staging].[AdmissionStatusCode],&#xA;    [Staging].[RecordCreatedAt],&#xA;    [Staging].[RecordUpdatedAt],&#xA;    [Staging].[IsDeleted],&#xA;&#xA;    CASE&#xA;        WHEN [Staging].[DischargeDateTime] IS NOT NULL&#xA;         AND [Staging].[AdmissionDateTime] IS NOT NULL&#xA;         AND [Staging].[DischargeDateTime] &lt; [Staging].[AdmissionDateTime]&#xA;        THEN 'DQ-ADM-001'&#xA;&#xA;        WHEN [Staging].[AdmissionStatusCode] = 'OPEN'&#xA;         AND&#xA;         (&#xA;              [Staging].[DischargeDateTime] IS NOT NULL&#xA;           OR [Staging].[DischargeMethodCode] IS NOT NULL&#xA;           OR [Staging].[DischargeDestinationCode] IS NOT NULL&#xA;         )&#xA;        THEN 'DQ-ADM-002'&#xA;&#xA;        WHEN [Staging].[AdmissionStatusCode] = 'DISCHARGED'&#xA;         AND&#xA;         (&#xA;              [Staging].[DischargeDateTime] IS NULL&#xA;           OR [Staging].[DischargeMethodCode] IS NULL&#xA;           OR [Staging].[DischargeDestinationCode] IS NULL&#xA;         )&#xA;        THEN 'DQ-ADM-003'&#xA;&#xA;        WHEN [Staging].[PatientLookupStatus] = 'NOT_FOUND'&#xA;        THEN 'DQ-ADM-004'&#xA;&#xA;        WHEN [Staging].[OrganisationLookupStatus] = 'NOT_FOUND'&#xA;          OR [Staging].[SiteLookupStatus] = 'NOT_FOUND'&#xA;        THEN 'DQ-ADM-005'&#xA;&#xA;        ELSE 'VALIDATION_FAILURE'&#xA;    END,&#xA;&#xA;    CASE&#xA;        WHEN [Staging].[DischargeDateTime] IS NOT NULL&#xA;         AND [Staging].[AdmissionDateTime] IS NOT NULL&#xA;         AND [Staging].[DischargeDateTime] &lt; [Staging].[AdmissionDateTime]&#xA;        THEN N'Discharge date and time occurs before admission date and time.'&#xA;&#xA;        WHEN [Staging].[AdmissionStatusCode] = 'OPEN'&#xA;         AND&#xA;         (&#xA;              [Staging].[DischargeDateTime] IS NOT NULL&#xA;           OR [Staging].[DischargeMethodCode] IS NOT NULL&#xA;           OR [Staging].[DischargeDestinationCode] IS NOT NULL&#xA;         )&#xA;        THEN N'Open admission contains one or more discharge values.'&#xA;&#xA;        WHEN [Staging].[AdmissionStatusCode] = 'DISCHARGED'&#xA;         AND&#xA;         (&#xA;              [Staging].[DischargeDateTime] IS NULL&#xA;           OR [Staging].[DischargeMethodCode] IS NULL&#xA;           OR [Staging].[DischargeDestinationCode] IS NULL&#xA;         )&#xA;        THEN N'Discharged admission is missing one or more required discharge values.'&#xA;&#xA;        WHEN [Staging].[PatientLookupStatus] = 'NOT_FOUND'&#xA;        THEN N'Admission references an unknown patient.'&#xA;&#xA;        WHEN [Staging].[OrganisationLookupStatus] = 'NOT_FOUND'&#xA;          OR [Staging].[SiteLookupStatus] = 'NOT_FOUND'&#xA;        THEN N'Admission references an unknown or inconsistent organisation and site.'&#xA;&#xA;        ELSE N'Admission failed one or more configured validation rules.'&#xA;    END,&#xA;&#xA;    [Staging].[ValidationFailureCount],&#xA;    'OPEN',&#xA;    SYSUTCDATETIME()&#xA;FROM [stg].[Admission] AS [Staging]&#xA;INNER JOIN [landing].[Admission] AS [Landing]&#xA;    ON [Landing].[LandingAdmissionId] = [Staging].[LandingAdmissionId]&#xA;WHERE [Staging].[BatchId] = ?&#xA;  AND [Staging].[PackageExecutionId] = ?&#xA;  AND [Staging].[ProcessingOutcome] = 'QUARANTINED'&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM [quarantine].[Admission] AS [Existing]&#xA;      WHERE [Existing].[BatchId] = [Staging].[BatchId]&#xA;        AND [Existing].[LandingAdmissionId] = [Staging].[LandingAdmissionId]&#xA;  );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::PackageExecutionId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Populate_Staging_Admissions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1ED1E16C-AD59-459E-80D6-ED00E9ED53E2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Populate_Staging_Admissions"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F6208311-4AF5-4F7F-9F74-B83868D8B68C}"
          SQLTask:SqlStatementSource="INSERT INTO [stg].[Admission]&#xA;(&#xA;    [LandingAdmissionId],&#xA;    [BatchId],&#xA;    [PackageExecutionId],&#xA;    [SourceSystemCode],&#xA;    [SourceRecordIdentifier],&#xA;    [SourceRowNumber],&#xA;    [AdmissionId],&#xA;    [PatientId],&#xA;    [OrganisationId],&#xA;    [SiteId],&#xA;    [AdmissionNumber],&#xA;    [PatientPathwayId],&#xA;    [AdmissionDateTime],&#xA;    [DischargeDateTime],&#xA;    [AdmissionMethodCode],&#xA;    [AdmissionSourceCode],&#xA;    [PatientClassificationCode],&#xA;    [IntendedManagementCode],&#xA;    [DischargeMethodCode],&#xA;    [DischargeDestinationCode],&#xA;    [AdministrativeCategoryCode],&#xA;    [LegalStatusCode],&#xA;    [AdmissionStatusCode],&#xA;    [RecordCreatedAt],&#xA;    [RecordUpdatedAt],&#xA;    [IsDeleted]&#xA;)&#xA;SELECT&#xA;    [LandingAdmissionId],&#xA;    [BatchId],&#xA;    [PackageExecutionId],&#xA;    [SourceSystemCode],&#xA;    [SourceRecordIdentifier],&#xA;    [SourceRowNumber],&#xA;    [AdmissionId],&#xA;    [PatientId],&#xA;    [OrganisationId],&#xA;    [SiteId],&#xA;    [AdmissionNumber],&#xA;    [PatientPathwayId],&#xA;    [AdmissionDateTime],&#xA;    [DischargeDateTime],&#xA;    [AdmissionMethodCode],&#xA;    [AdmissionSourceCode],&#xA;    [PatientClassificationCode],&#xA;    [IntendedManagementCode],&#xA;    [DischargeMethodCode],&#xA;    [DischargeDestinationCode],&#xA;    [AdministrativeCategoryCode],&#xA;    [LegalStatusCode],&#xA;    [AdmissionStatusCode],&#xA;    [RecordCreatedAt],&#xA;    [RecordUpdatedAt],&#xA;    [IsDeleted]&#xA;FROM [landing].[Admission]&#xA;WHERE [BatchId] = ?&#xA;  AND [PackageExecutionId] = ?&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM [stg].[Admission] AS [Existing]&#xA;      WHERE [Existing].[LandingAdmissionId] =&#xA;            [landing].[Admission].[LandingAdmissionId]&#xA;  );&#xA;&#xA;IF @@ROWCOUNT = 0&#xA;BEGIN&#xA;    THROW 51000, 'No admission rows were inserted into staging.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::PackageExecutionId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Register_Batch"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B61FE247-60D9-4345-921F-C93190FD749C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Register_Batch"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9A90D54D-FEEE-4092-A847-BF2DB78C3E88}"
          SQLTask:SqlStatementSource="DECLARE @InterfaceId INT;&#xA;&#xA;SELECT&#xA;    @InterfaceId = [InterfaceId]&#xA;FROM [audit].[Interface]&#xA;WHERE [InterfaceCode] = ?;&#xA;&#xA;IF @InterfaceId IS NULL&#xA;BEGIN&#xA;    THROW 51000, 'The requested Aegis interface code is not configured.', 1;&#xA;END;&#xA;&#xA;INSERT INTO [audit].[Batch]&#xA;(&#xA;    [InterfaceId],&#xA;    [SourceFileName],&#xA;    [BatchStatus],&#xA;    [ReceivedAt]&#xA;)&#xA;VALUES&#xA;(&#xA;    @InterfaceId,&#xA;    N'admission_defects.csv',&#xA;    'RECEIVED',&#xA;    SYSUTCDATETIME()&#xA;);&#xA;&#xA;SELECT&#xA;    [BatchId] = CONVERT(BIGINT, SCOPE_IDENTITY());"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="BatchId"
            SQLTask:DtsVariableName="User::BatchId" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::InterfaceCode"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="50" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Register_Package_Execution"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7C3D6703-9FBA-47A5-8FFD-2B7CCA57A8B8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Register_Package_Execution"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9A90D54D-FEEE-4092-A847-BF2DB78C3E88}"
          SQLTask:SqlStatementSource="IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM [audit].[Batch]&#xA;    WHERE [BatchId] = ?&#xA;)&#xA;BEGIN&#xA;    THROW 51000, 'The Aegis batch could not be found.', 1;&#xA;END;&#xA;&#xA;UPDATE [audit].[Batch]&#xA;SET&#xA;    [BatchStatus] = 'PROCESSING',&#xA;    [StartedAt] = COALESCE([StartedAt], SYSUTCDATETIME()),&#xA;    [UpdatedAt] = SYSUTCDATETIME()&#xA;WHERE [BatchId] = ?;&#xA;&#xA;INSERT INTO [audit].[PackageExecution]&#xA;(&#xA;    [BatchId],&#xA;    [PackageName],&#xA;    [ExecutionStatus],&#xA;    [StartedAt]&#xA;)&#xA;VALUES&#xA;(&#xA;    ?,&#xA;    ?,&#xA;    'STARTED',&#xA;    SYSUTCDATETIME()&#xA;);&#xA;&#xA;SELECT&#xA;    [PackageExecutionId] =&#xA;        CONVERT(BIGINT, SCOPE_IDENTITY());"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="PackageExecutionId"
            SQLTask:DtsVariableName="User::PackageExecutionId" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::BatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::BatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::PackageName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="260" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Write_Data_Quality_Exceptions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{243C8DD4-1485-466E-A5A8-85320F138D97}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Write_Data_Quality_Exceptions"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9A90D54D-FEEE-4092-A847-BF2DB78C3E88}"
          SQLTask:SqlStatementSource="DECLARE @BatchId BIGINT = ?;&#xA;DECLARE @PackageExecutionId BIGINT = ?;&#xA;&#xA;INSERT INTO [dq].[DataQualityException]&#xA;(&#xA;    [RecordOutcomeId],&#xA;    [BatchId],&#xA;    [PackageExecutionId],&#xA;    [ValidationRuleId],&#xA;    [SourceDomain],&#xA;    [SourceObject],&#xA;    [SourceRecordIdentifier],&#xA;    [SourceColumnName],&#xA;    [SourceValue],&#xA;    [ExpectedValue],&#xA;    [ErrorCode],&#xA;    [ErrorDetail],&#xA;    [ResolutionStatus],&#xA;    [QuarantinedAt]&#xA;)&#xA;SELECT&#xA;    [Outcome].[RecordOutcomeId],&#xA;    [Staging].[BatchId],&#xA;    [Staging].[PackageExecutionId],&#xA;    [Rule].[ValidationRuleId],&#xA;    'PAS_ACTIVITY',&#xA;    'Admission',&#xA;    [Staging].[SourceRecordIdentifier],&#xA;    N'DischargeDateTime',&#xA;    CONVERT(NVARCHAR(50), [Staging].[DischargeDateTime], 126),&#xA;    N'DischargeDateTime must be greater than or equal to AdmissionDateTime.',&#xA;    [Rule].[ErrorCode],&#xA;    N'The discharge date and time occurs before the admission date and time.',&#xA;    'OPEN',&#xA;    SYSUTCDATETIME()&#xA;FROM [Aegis_Staging].[stg].[Admission] AS [Staging]&#xA;INNER JOIN [audit].[RecordOutcome] AS [Outcome]&#xA;    ON [Outcome].[BatchId] = [Staging].[BatchId]&#xA;   AND [Outcome].[PackageExecutionId] = [Staging].[PackageExecutionId]&#xA;   AND [Outcome].[SourceDomain] = 'PAS_ACTIVITY'&#xA;   AND [Outcome].[SourceObject] = 'Admission'&#xA;   AND [Outcome].[SourceRecordIdentifier] = [Staging].[SourceRecordIdentifier]&#xA;INNER JOIN [dq].[ValidationRule] AS [Rule]&#xA;    ON [Rule].[ValidationRuleCode] = 'DQ-ADM-001'&#xA;   AND [Rule].[ValidationRuleVersion] = 1&#xA;   AND [Rule].[IsActive] = 1&#xA;WHERE [Staging].[BatchId] = @BatchId&#xA;  AND [Staging].[PackageExecutionId] = @PackageExecutionId&#xA;  AND [Staging].[DischargeDateTime] IS NOT NULL&#xA;  AND [Staging].[AdmissionDateTime] IS NOT NULL&#xA;  AND [Staging].[DischargeDateTime] &lt; [Staging].[AdmissionDateTime]&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM [dq].[DataQualityException] AS [Existing]&#xA;      WHERE [Existing].[RecordOutcomeId] = [Outcome].[RecordOutcomeId]&#xA;        AND [Existing].[ValidationRuleId] = [Rule].[ValidationRuleId]&#xA;  );&#xA;&#xA;INSERT INTO [dq].[DataQualityException]&#xA;(&#xA;    [RecordOutcomeId],&#xA;    [BatchId],&#xA;    [PackageExecutionId],&#xA;    [ValidationRuleId],&#xA;    [SourceDomain],&#xA;    [SourceObject],&#xA;    [SourceRecordIdentifier],&#xA;    [SourceColumnName],&#xA;    [SourceValue],&#xA;    [ExpectedValue],&#xA;    [ErrorCode],&#xA;    [ErrorDetail],&#xA;    [ResolutionStatus],&#xA;    [QuarantinedAt]&#xA;)&#xA;SELECT&#xA;    [Outcome].[RecordOutcomeId],&#xA;    [Staging].[BatchId],&#xA;    [Staging].[PackageExecutionId],&#xA;    [Rule].[ValidationRuleId],&#xA;    'PAS_ACTIVITY',&#xA;    'Admission',&#xA;    [Staging].[SourceRecordIdentifier],&#xA;    N'AdmissionStatusCode',&#xA;    [Staging].[AdmissionStatusCode],&#xA;    N'Open admissions must not contain discharge details.',&#xA;    [Rule].[ErrorCode],&#xA;    N'The admission is marked as open but contains one or more discharge values.',&#xA;    'OPEN',&#xA;    SYSUTCDATETIME()&#xA;FROM [Aegis_Staging].[stg].[Admission] AS [Staging]&#xA;INNER JOIN [audit].[RecordOutcome] AS [Outcome]&#xA;    ON [Outcome].[BatchId] = [Staging].[BatchId]&#xA;   AND [Outcome].[PackageExecutionId] = [Staging].[PackageExecutionId]&#xA;   AND [Outcome].[SourceDomain] = 'PAS_ACTIVITY'&#xA;   AND [Outcome].[SourceObject] = 'Admission'&#xA;   AND [Outcome].[SourceRecordIdentifier] = [Staging].[SourceRecordIdentifier]&#xA;INNER JOIN [dq].[ValidationRule] AS [Rule]&#xA;    ON [Rule].[ValidationRuleCode] = 'DQ-ADM-002'&#xA;   AND [Rule].[ValidationRuleVersion] = 1&#xA;   AND [Rule].[IsActive] = 1&#xA;WHERE [Staging].[BatchId] = @BatchId&#xA;  AND [Staging].[PackageExecutionId] = @PackageExecutionId&#xA;  AND [Staging].[AdmissionStatusCode] = 'OPEN'&#xA;  AND&#xA;  (&#xA;       [Staging].[DischargeDateTime] IS NOT NULL&#xA;    OR [Staging].[DischargeMethodCode] IS NOT NULL&#xA;    OR [Staging].[DischargeDestinationCode] IS NOT NULL&#xA;  )&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM [dq].[DataQualityException] AS [Existing]&#xA;      WHERE [Existing].[RecordOutcomeId] = [Outcome].[RecordOutcomeId]&#xA;        AND [Existing].[ValidationRuleId] = [Rule].[ValidationRuleId]&#xA;  );&#xA;&#xA;INSERT INTO [dq].[DataQualityException]&#xA;(&#xA;    [RecordOutcomeId],&#xA;    [BatchId],&#xA;    [PackageExecutionId],&#xA;    [ValidationRuleId],&#xA;    [SourceDomain],&#xA;    [SourceObject],&#xA;    [SourceRecordIdentifier],&#xA;    [SourceColumnName],&#xA;    [SourceValue],&#xA;    [ExpectedValue],&#xA;    [ErrorCode],&#xA;    [ErrorDetail],&#xA;    [ResolutionStatus],&#xA;    [QuarantinedAt]&#xA;)&#xA;SELECT&#xA;    [Outcome].[RecordOutcomeId],&#xA;    [Staging].[BatchId],&#xA;    [Staging].[PackageExecutionId],&#xA;    [Rule].[ValidationRuleId],&#xA;    'PAS_ACTIVITY',&#xA;    'Admission',&#xA;    [Staging].[SourceRecordIdentifier],&#xA;    N'AdmissionStatusCode',&#xA;    [Staging].[AdmissionStatusCode],&#xA;    N'Discharged admissions must contain discharge date, method and destination.',&#xA;    [Rule].[ErrorCode],&#xA;    N'The admission is marked as discharged but one or more required discharge values are missing.',&#xA;    'OPEN',&#xA;    SYSUTCDATETIME()&#xA;FROM [Aegis_Staging].[stg].[Admission] AS [Staging]&#xA;INNER JOIN [audit].[RecordOutcome] AS [Outcome]&#xA;    ON [Outcome].[BatchId] = [Staging].[BatchId]&#xA;   AND [Outcome].[PackageExecutionId] = [Staging].[PackageExecutionId]&#xA;   AND [Outcome].[SourceDomain] = 'PAS_ACTIVITY'&#xA;   AND [Outcome].[SourceObject] = 'Admission'&#xA;   AND [Outcome].[SourceRecordIdentifier] = [Staging].[SourceRecordIdentifier]&#xA;INNER JOIN [dq].[ValidationRule] AS [Rule]&#xA;    ON [Rule].[ValidationRuleCode] = 'DQ-ADM-003'&#xA;   AND [Rule].[ValidationRuleVersion] = 1&#xA;   AND [Rule].[IsActive] = 1&#xA;WHERE [Staging].[BatchId] = @BatchId&#xA;  AND [Staging].[PackageExecutionId] = @PackageExecutionId&#xA;  AND [Staging].[AdmissionStatusCode] = 'DISCHARGED'&#xA;  AND&#xA;  (&#xA;       [Staging].[DischargeDateTime] IS NULL&#xA;    OR [Staging].[DischargeMethodCode] IS NULL&#xA;    OR [Staging].[DischargeDestinationCode] IS NULL&#xA;  )&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM [dq].[DataQualityException] AS [Existing]&#xA;      WHERE [Existing].[RecordOutcomeId] = [Outcome].[RecordOutcomeId]&#xA;        AND [Existing].[ValidationRuleId] = [Rule].[ValidationRuleId]&#xA;  );&#xA;&#xA;INSERT INTO [dq].[DataQualityException]&#xA;(&#xA;    [RecordOutcomeId],&#xA;    [BatchId],&#xA;    [PackageExecutionId],&#xA;    [ValidationRuleId],&#xA;    [SourceDomain],&#xA;    [SourceObject],&#xA;    [SourceRecordIdentifier],&#xA;    [SourceColumnName],&#xA;    [SourceValue],&#xA;    [ExpectedValue],&#xA;    [ErrorCode],&#xA;    [ErrorDetail],&#xA;    [ResolutionStatus],&#xA;    [QuarantinedAt]&#xA;)&#xA;SELECT&#xA;    [Outcome].[RecordOutcomeId],&#xA;    [Staging].[BatchId],&#xA;    [Staging].[PackageExecutionId],&#xA;    [Rule].[ValidationRuleId],&#xA;    'PAS_ACTIVITY',&#xA;    'Admission',&#xA;    [Staging].[SourceRecordIdentifier],&#xA;    N'PatientId',&#xA;    CONVERT(NVARCHAR(50), [Staging].[PatientId]),&#xA;    N'PatientId must resolve to Aegis_Source.pas.Patient.',&#xA;    [Rule].[ErrorCode],&#xA;    N'The admission references an unknown patient.',&#xA;    'OPEN',&#xA;    SYSUTCDATETIME()&#xA;FROM [Aegis_Staging].[stg].[Admission] AS [Staging]&#xA;INNER JOIN [audit].[RecordOutcome] AS [Outcome]&#xA;    ON [Outcome].[BatchId] = [Staging].[BatchId]&#xA;   AND [Outcome].[PackageExecutionId] = [Staging].[PackageExecutionId]&#xA;   AND [Outcome].[SourceDomain] = 'PAS_ACTIVITY'&#xA;   AND [Outcome].[SourceObject] = 'Admission'&#xA;   AND [Outcome].[SourceRecordIdentifier] = [Staging].[SourceRecordIdentifier]&#xA;INNER JOIN [dq].[ValidationRule] AS [Rule]&#xA;    ON [Rule].[ValidationRuleCode] = 'DQ-ADM-004'&#xA;   AND [Rule].[ValidationRuleVersion] = 1&#xA;   AND [Rule].[IsActive] = 1&#xA;WHERE [Staging].[BatchId] = @BatchId&#xA;  AND [Staging].[PackageExecutionId] = @PackageExecutionId&#xA;  AND [Staging].[PatientLookupStatus] = 'NOT_FOUND'&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM [dq].[DataQualityException] AS [Existing]&#xA;      WHERE [Existing].[RecordOutcomeId] = [Outcome].[RecordOutcomeId]&#xA;        AND [Existing].[ValidationRuleId] = [Rule].[ValidationRuleId]&#xA;  );&#xA;&#xA;INSERT INTO [dq].[DataQualityException]&#xA;(&#xA;    [RecordOutcomeId],&#xA;    [BatchId],&#xA;    [PackageExecutionId],&#xA;    [ValidationRuleId],&#xA;    [SourceDomain],&#xA;    [SourceObject],&#xA;    [SourceRecordIdentifier],&#xA;    [SourceColumnName],&#xA;    [SourceValue],&#xA;    [ExpectedValue],&#xA;    [ErrorCode],&#xA;    [ErrorDetail],&#xA;    [ResolutionStatus],&#xA;    [QuarantinedAt]&#xA;)&#xA;SELECT&#xA;    [Outcome].[RecordOutcomeId],&#xA;    [Staging].[BatchId],&#xA;    [Staging].[PackageExecutionId],&#xA;    [Rule].[ValidationRuleId],&#xA;    'PAS_ACTIVITY',&#xA;    'Admission',&#xA;    [Staging].[SourceRecordIdentifier],&#xA;    N'OrganisationId/SiteId',&#xA;    CONCAT&#xA;    (&#xA;        N'OrganisationId=',&#xA;        COALESCE(CONVERT(NVARCHAR(50), [Staging].[OrganisationId]), N'NULL'),&#xA;        N'; SiteId=',&#xA;        COALESCE(CONVERT(NVARCHAR(50), [Staging].[SiteId]), N'NULL')&#xA;    ),&#xA;    N'Organisation and site must resolve, and the site must belong to the organisation.',&#xA;    [Rule].[ErrorCode],&#xA;    N'The admission references an unknown or inconsistent organisation and site combination.',&#xA;    'OPEN',&#xA;    SYSUTCDATETIME()&#xA;FROM [Aegis_Staging].[stg].[Admission] AS [Staging]&#xA;INNER JOIN [audit].[RecordOutcome] AS [Outcome]&#xA;    ON [Outcome].[BatchId] = [Staging].[BatchId]&#xA;   AND [Outcome].[PackageExecutionId] = [Staging].[PackageExecutionId]&#xA;   AND [Outcome].[SourceDomain] = 'PAS_ACTIVITY'&#xA;   AND [Outcome].[SourceObject] = 'Admission'&#xA;   AND [Outcome].[SourceRecordIdentifier] = [Staging].[SourceRecordIdentifier]&#xA;INNER JOIN [dq].[ValidationRule] AS [Rule]&#xA;    ON [Rule].[ValidationRuleCode] = 'DQ-ADM-005'&#xA;   AND [Rule].[ValidationRuleVersion] = 1&#xA;   AND [Rule].[IsActive] = 1&#xA;WHERE [Staging].[BatchId] = @BatchId&#xA;  AND [Staging].[PackageExecutionId] = @PackageExecutionId&#xA;  AND&#xA;  (&#xA;       [Staging].[OrganisationLookupStatus] = 'NOT_FOUND'&#xA;    OR [Staging].[SiteLookupStatus] = 'NOT_FOUND'&#xA;  )&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM [dq].[DataQualityException] AS [Existing]&#xA;      WHERE [Existing].[RecordOutcomeId] = [Outcome].[RecordOutcomeId]&#xA;        AND [Existing].[ValidationRuleId] = [Rule].[ValidationRuleId]&#xA;  );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
