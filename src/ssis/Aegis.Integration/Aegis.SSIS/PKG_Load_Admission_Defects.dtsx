    <DTS:Executable
      DTS:refId="Package\SQL_Classify_Staging_Admissions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6F46FE3E-D13D-492C-A631-A0F1E309AFD8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Classify_Staging_Admissions"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F6208311-4AF5-4F7F-9F74-B83868D8B68C}"
          SQLTask:SqlStatementSource="UPDATE [Staging]&#xA;SET&#xA;    [PatientLookupStatus] =&#xA;        CASE&#xA;            WHEN [Patient].[PatientId] IS NOT NULL THEN 'MATCHED'&#xA;            ELSE 'NOT_FOUND'&#xA;        END,&#xA;&#xA;    [OrganisationLookupStatus] =&#xA;        CASE&#xA;            WHEN [Organisation].[OrganisationId] IS NOT NULL THEN 'MATCHED'&#xA;            ELSE 'NOT_FOUND'&#xA;        END,&#xA;&#xA;    [SiteLookupStatus] =&#xA;        CASE&#xA;            WHEN [Site].[SiteId] IS NOT NULL&#xA;             AND [Site].[OrganisationId] = [Staging].[OrganisationId]&#xA;            THEN 'MATCHED'&#xA;            ELSE 'NOT_FOUND'&#xA;        END,&#xA;&#xA;    [ValidationFailureCount] =&#xA;          CASE&#xA;              WHEN [Staging].[DischargeDateTime] IS NOT NULL&#xA;               AND [Staging].[AdmissionDateTime] IS NOT NULL&#xA;               AND [Staging].[DischargeDateTime] &lt; [Staging].[AdmissionDateTime]&#xA;              THEN 1 ELSE 0&#xA;          END&#xA;        + CASE&#xA;              WHEN [Staging].[AdmissionStatusCode] = 'OPEN'&#xA;               AND&#xA;               (&#xA;                    [Staging].[DischargeDateTime] IS NOT NULL&#xA;                 OR [Staging].[DischargeMethodCode] IS NOT NULL&#xA;                 OR [Staging].[DischargeDestinationCode] IS NOT NULL&#xA;               )&#xA;              THEN 1 ELSE 0&#xA;          END&#xA;        + CASE&#xA;              WHEN [Staging].[AdmissionStatusCode] = 'DISCHARGED'&#xA;               AND&#xA;               (&#xA;                    [Staging].[DischargeDateTime] IS NULL&#xA;                 OR [Staging].[DischargeMethodCode] IS NULL&#xA;                 OR [Staging].[DischargeDestinationCode] IS NULL&#xA;               )&#xA;              THEN 1 ELSE 0&#xA;          END&#xA;        + CASE&#xA;              WHEN [Patient].[PatientId] IS NULL&#xA;              THEN 1 ELSE 0&#xA;          END&#xA;        + CASE&#xA;              WHEN [Organisation].[OrganisationId] IS NULL&#xA;                OR [Site].[SiteId] IS NULL&#xA;                OR [Site].[OrganisationId] &lt;&gt; [Staging].[OrganisationId]&#xA;              THEN 1 ELSE 0&#xA;          END,&#xA;&#xA;    [ValidationStatus] =&#xA;        CASE&#xA;            WHEN&#xA;            (&#xA;                  CASE&#xA;                      WHEN [Staging].[DischargeDateTime] IS NOT NULL&#xA;                       AND [Staging].[AdmissionDateTime] IS NOT NULL&#xA;                       AND [Staging].[DischargeDateTime] &lt; [Staging].[AdmissionDateTime]&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Staging].[AdmissionStatusCode] = 'OPEN'&#xA;                       AND&#xA;                       (&#xA;                            [Staging].[DischargeDateTime] IS NOT NULL&#xA;                         OR [Staging].[DischargeMethodCode] IS NOT NULL&#xA;                         OR [Staging].[DischargeDestinationCode] IS NOT NULL&#xA;                       )&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Staging].[AdmissionStatusCode] = 'DISCHARGED'&#xA;                       AND&#xA;                       (&#xA;                            [Staging].[DischargeDateTime] IS NULL&#xA;                         OR [Staging].[DischargeMethodCode] IS NULL&#xA;                         OR [Staging].[DischargeDestinationCode] IS NULL&#xA;                       )&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Patient].[PatientId] IS NULL&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Organisation].[OrganisationId] IS NULL&#xA;                        OR [Site].[SiteId] IS NULL&#xA;                        OR [Site].[OrganisationId] &lt;&gt; [Staging].[OrganisationId]&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;            ) = 0&#xA;            THEN 'VALID'&#xA;            ELSE 'INVALID'&#xA;        END,&#xA;&#xA;    [ProcessingOutcome] =&#xA;        CASE&#xA;            WHEN&#xA;            (&#xA;                  CASE&#xA;                      WHEN [Staging].[DischargeDateTime] IS NOT NULL&#xA;                       AND [Staging].[AdmissionDateTime] IS NOT NULL&#xA;                       AND [Staging].[DischargeDateTime] &lt; [Staging].[AdmissionDateTime]&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Staging].[AdmissionStatusCode] = 'OPEN'&#xA;                       AND&#xA;                       (&#xA;                            [Staging].[DischargeDateTime] IS NOT NULL&#xA;                         OR [Staging].[DischargeMethodCode] IS NOT NULL&#xA;                         OR [Staging].[DischargeDestinationCode] IS NOT NULL&#xA;                       )&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Staging].[AdmissionStatusCode] = 'DISCHARGED'&#xA;                       AND&#xA;                       (&#xA;                            [Staging].[DischargeDateTime] IS NULL&#xA;                         OR [Staging].[DischargeMethodCode] IS NULL&#xA;                         OR [Staging].[DischargeDestinationCode] IS NULL&#xA;                       )&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Patient].[PatientId] IS NULL&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Organisation].[OrganisationId] IS NULL&#xA;                        OR [Site].[SiteId] IS NULL&#xA;                        OR [Site].[OrganisationId] &lt;&gt; [Staging].[OrganisationId]&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;            ) = 0&#xA;            THEN 'ACCEPTED'&#xA;            ELSE 'QUARANTINED'&#xA;        END,&#xA;&#xA;    [AcceptedAt] =&#xA;        CASE&#xA;            WHEN&#xA;            (&#xA;                  CASE&#xA;                      WHEN [Staging].[DischargeDateTime] IS NOT NULL&#xA;                       AND [Staging].[AdmissionDateTime] IS NOT NULL&#xA;                       AND [Staging].[DischargeDateTime] &lt; [Staging].[AdmissionDateTime]&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Staging].[AdmissionStatusCode] = 'OPEN'&#xA;                       AND&#xA;                       (&#xA;                            [Staging].[DischargeDateTime] IS NOT NULL&#xA;                         OR [Staging].[DischargeMethodCode] IS NOT NULL&#xA;                         OR [Staging].[DischargeDestinationCode] IS NOT NULL&#xA;                       )&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Staging].[AdmissionStatusCode] = 'DISCHARGED'&#xA;                       AND&#xA;                       (&#xA;                            [Staging].[DischargeDateTime] IS NULL&#xA;                         OR [Staging].[DischargeMethodCode] IS NULL&#xA;                         OR [Staging].[DischargeDestinationCode] IS NULL&#xA;                       )&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Patient].[PatientId] IS NULL&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;                + CASE&#xA;                      WHEN [Organisation].[OrganisationId] IS NULL&#xA;                        OR [Site].[SiteId] IS NULL&#xA;                        OR [Site].[OrganisationId] &lt;&gt; [Staging].[OrganisationId]&#xA;                      THEN 1 ELSE 0&#xA;                  END&#xA;            ) = 0&#xA;            THEN SYSUTCDATETIME()&#xA;            ELSE NULL&#xA;        END,&#xA;&#xA;    [ClassifiedAt] = SYSUTCDATETIME(),&#xA;    [UpdatedAt] = SYSUTCDATETIME()&#xA;&#xA;FROM [stg].[Admission] AS [Staging]&#xA;&#xA;LEFT JOIN [Aegis_Source].[pas].[Patient] AS [Patient]&#xA;    ON [Patient].[PatientId] = [Staging].[PatientId]&#xA;&#xA;LEFT JOIN [Aegis_Source].[ref].[Organisation] AS [Organisation]&#xA;    ON [Organisation].[OrganisationId] = [Staging].[OrganisationId]&#xA;&#xA;LEFT JOIN [Aegis_Source].[ref].[Site] AS [Site]&#xA;    ON [Site].[SiteId] = [Staging].[SiteId]&#xA;&#xA;WHERE [Staging].[BatchId] = ?&#xA;  AND [Staging].[PackageExecutionId] = ?&#xA;  AND [Staging].[ValidationStatus] = 'NOT_VALIDATED';&#xA;&#xA;IF @@ROWCOUNT = 0&#xA;BEGIN&#xA;    THROW 51000, 'No admission staging rows were classified.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::PackageExecutionId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Finalise_Admission_Batch"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{52F879CD-D470-4583-8E05-A99FAA686D29}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Finalise_Admission_Batch"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9A90D54D-FEEE-4092-A847-BF2DB78C3E88}"
          SQLTask:SqlStatementSource="DECLARE @BatchId BIGINT = ?;&#xA;DECLARE @PackageExecutionId BIGINT = ?;&#xA;&#xA;DECLARE @SourceRowCount BIGINT;&#xA;DECLARE @LandedRowCount BIGINT;&#xA;DECLARE @StagingRowCount BIGINT;&#xA;DECLARE @OutcomeRowCount BIGINT;&#xA;DECLARE @AcceptedRowCount BIGINT;&#xA;DECLARE @RejectedRowCount BIGINT;&#xA;DECLARE @QuarantinedRowCount BIGINT;&#xA;DECLARE @WarningRowCount BIGINT;&#xA;DECLARE @DuplicateRowCount BIGINT;&#xA;DECLARE @ExceptionCount BIGINT;&#xA;DECLARE @PhysicalQuarantineRowCount BIGINT;&#xA;&#xA;SELECT&#xA;    @SourceRowCount = [SourceRowCount],&#xA;    @LandedRowCount = [LandedRowCount]&#xA;FROM [audit].[PackageExecution]&#xA;WHERE [PackageExecutionId] = @PackageExecutionId&#xA;  AND [BatchId] = @BatchId;&#xA;&#xA;SELECT&#xA;    @StagingRowCount = COUNT_BIG(*),&#xA;    @AcceptedRowCount =&#xA;        SUM(CASE WHEN [ProcessingOutcome] = 'ACCEPTED' THEN 1 ELSE 0 END),&#xA;    @RejectedRowCount =&#xA;        SUM(CASE WHEN [ProcessingOutcome] = 'REJECTED' THEN 1 ELSE 0 END),&#xA;    @QuarantinedRowCount =&#xA;        SUM(CASE WHEN [ProcessingOutcome] = 'QUARANTINED' THEN 1 ELSE 0 END),&#xA;    @WarningRowCount =&#xA;        SUM(CASE WHEN [ProcessingOutcome] = 'WARNING' THEN 1 ELSE 0 END),&#xA;    @DuplicateRowCount =&#xA;        SUM(CASE WHEN [ProcessingOutcome] = 'DUPLICATE' THEN 1 ELSE 0 END)&#xA;FROM [Aegis_Staging].[stg].[Admission]&#xA;WHERE [BatchId] = @BatchId&#xA;  AND [PackageExecutionId] = @PackageExecutionId;&#xA;&#xA;SELECT&#xA;    @OutcomeRowCount = COUNT_BIG(*)&#xA;FROM [audit].[RecordOutcome]&#xA;WHERE [BatchId] = @BatchId&#xA;  AND [PackageExecutionId] = @PackageExecutionId&#xA;  AND [SourceDomain] = 'PAS_ACTIVITY'&#xA;  AND [SourceObject] = 'Admission';&#xA;&#xA;SELECT&#xA;    @ExceptionCount = COUNT_BIG(*)&#xA;FROM [dq].[DataQualityException]&#xA;WHERE [BatchId] = @BatchId&#xA;  AND [PackageExecutionId] = @PackageExecutionId&#xA;  AND [SourceDomain] = 'PAS_ACTIVITY'&#xA;  AND [SourceObject] = 'Admission';&#xA;&#xA;SELECT&#xA;    @PhysicalQuarantineRowCount = COUNT_BIG(*)&#xA;FROM [Aegis_Staging].[quarantine].[Admission]&#xA;WHERE [BatchId] = @BatchId&#xA;  AND [PackageExecutionId] = @PackageExecutionId;&#xA;&#xA;SET @AcceptedRowCount = COALESCE(@AcceptedRowCount, 0);&#xA;SET @RejectedRowCount = COALESCE(@RejectedRowCount, 0);&#xA;SET @QuarantinedRowCount = COALESCE(@QuarantinedRowCount, 0);&#xA;SET @WarningRowCount = COALESCE(@WarningRowCount, 0);&#xA;SET @DuplicateRowCount = COALESCE(@DuplicateRowCount, 0);&#xA;SET @ExceptionCount = COALESCE(@ExceptionCount, 0);&#xA;SET @PhysicalQuarantineRowCount = COALESCE(@PhysicalQuarantineRowCount, 0);&#xA;&#xA;IF @SourceRowCount IS NULL&#xA;   OR @LandedRowCount IS NULL&#xA;BEGIN&#xA;    THROW 51000, 'Source or landing counts have not been recorded.', 1;&#xA;END;&#xA;&#xA;IF @SourceRowCount &lt;&gt; @LandedRowCount&#xA;BEGIN&#xA;    THROW 51000, 'Source and landing counts do not reconcile.', 1;&#xA;END;&#xA;&#xA;IF @LandedRowCount &lt;&gt; @StagingRowCount&#xA;BEGIN&#xA;    THROW 51000, 'Landing and staging counts do not reconcile.', 1;&#xA;END;&#xA;&#xA;IF @StagingRowCount &lt;&gt; @OutcomeRowCount&#xA;BEGIN&#xA;    THROW 51000, 'Staging rows and principal record outcomes do not reconcile.', 1;&#xA;END;&#xA;&#xA;IF @OutcomeRowCount &lt;&gt;&#xA;   (&#xA;       @AcceptedRowCount&#xA;       + @RejectedRowCount&#xA;       + @QuarantinedRowCount&#xA;       + @WarningRowCount&#xA;       + @DuplicateRowCount&#xA;   )&#xA;BEGIN&#xA;    THROW 51000, 'Principal record outcome totals do not reconcile.', 1;&#xA;END;&#xA;&#xA;IF @QuarantinedRowCount &lt;&gt; @PhysicalQuarantineRowCount&#xA;BEGIN&#xA;    THROW 51000, 'Quarantined outcomes and physical quarantine rows do not reconcile.', 1;&#xA;END;&#xA;&#xA;IF @QuarantinedRowCount &gt; 0&#xA;   AND @ExceptionCount &lt; @QuarantinedRowCount&#xA;BEGIN&#xA;    THROW 51000, 'One or more quarantined admissions have no data-quality exception.', 1;&#xA;END;&#xA;&#xA;UPDATE [audit].[PackageExecution]&#xA;SET&#xA;    [AcceptedRowCount] = @AcceptedRowCount,&#xA;    [RejectedRowCount] = @RejectedRowCount,&#xA;    [QuarantinedRowCount] = @QuarantinedRowCount,&#xA;    [WarningRowCount] = @WarningRowCount,&#xA;    [DuplicateRowCount] = @DuplicateRowCount,&#xA;    [ExecutionStatus] =&#xA;        CASE&#xA;            WHEN @RejectedRowCount &gt; 0&#xA;              OR @QuarantinedRowCount &gt; 0&#xA;              OR @WarningRowCount &gt; 0&#xA;              OR @DuplicateRowCount &gt; 0&#xA;            THEN 'SUCCEEDED_WITH_EXCEPTIONS'&#xA;            ELSE 'SUCCEEDED'&#xA;        END,&#xA;    [CompletedAt] = SYSUTCDATETIME(),&#xA;    [UpdatedAt] = SYSUTCDATETIME()&#xA;WHERE [PackageExecutionId] = @PackageExecutionId&#xA;  AND [BatchId] = @BatchId&#xA;  AND [ExecutionStatus] = 'STARTED';&#xA;&#xA;IF @@ROWCOUNT &lt;&gt; 1&#xA;BEGIN&#xA;    THROW 51000, 'The package-execution audit row could not be finalised.', 1;&#xA;END;&#xA;&#xA;UPDATE [audit].[Batch]&#xA;SET&#xA;    [AcceptedRowCount] = @AcceptedRowCount,&#xA;    [RejectedRowCount] = @RejectedRowCount,&#xA;    [QuarantinedRowCount] = @QuarantinedRowCount,&#xA;    [WarningRowCount] = @WarningRowCount,&#xA;    [DuplicateRowCount] = @DuplicateRowCount,&#xA;    [BatchStatus] =&#xA;        CASE&#xA;            WHEN @RejectedRowCount &gt; 0&#xA;              OR @QuarantinedRowCount &gt; 0&#xA;              OR @WarningRowCount &gt; 0&#xA;              OR @DuplicateRowCount &gt; 0&#xA;            THEN 'COMPLETED_WITH_EXCEPTIONS'&#xA;            ELSE 'COMPLETED'&#xA;        END,&#xA;    [CompletedAt] = SYSUTCDATETIME(),&#xA;    [UpdatedAt] = SYSUTCDATETIME()&#xA;WHERE [BatchId] = @BatchId&#xA;  AND [BatchStatus] = 'PROCESSING';&#xA;&#xA;IF @@ROWCOUNT &lt;&gt; 1&#xA;BEGIN&#xA;    THROW 51000, 'The batch audit row could not be finalised.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::PackageExecutionId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Finalise_Landing_Audit"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{35F47E07-D89B-45B0-963A-860EA6FDB253}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Finalise_Landing_Audit"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9A90D54D-FEEE-4092-A847-BF2DB78C3E88}"
          SQLTask:SqlStatementSource="DECLARE @ActualLandedRowCount BIGINT;&#xA;&#xA;SELECT&#xA;    @ActualLandedRowCount = COUNT_BIG(*)&#xA;FROM [Aegis_Staging].[landing].[Admission]&#xA;WHERE [BatchId] = ?&#xA;  AND [PackageExecutionId] = ?;&#xA;&#xA;IF @ActualLandedRowCount &lt;&gt; ?&#xA;BEGIN&#xA;    THROW 51000, 'The admission landing row count does not match the SSIS row-count variable.', 1;&#xA;END;&#xA;&#xA;UPDATE [audit].[PackageExecution]&#xA;SET&#xA;    [SourceRowCount] = ?,&#xA;    [LandedRowCount] = @ActualLandedRowCount,&#xA;    [UpdatedAt] = SYSUTCDATETIME()&#xA;WHERE [PackageExecutionId] = ?&#xA;  AND [BatchId] = ?&#xA;  AND [ExecutionStatus] = 'STARTED';&#xA;&#xA;IF @@ROWCOUNT &lt;&gt; 1&#xA;BEGIN&#xA;    THROW 51000, 'The Aegis package-execution audit row could not be updated after landing.', 1;&#xA;END;&#xA;&#xA;UPDATE [audit].[Batch]&#xA;SET&#xA;    [SourceRowCount] = ?,&#xA;    [LandedRowCount] = @ActualLandedRowCount,&#xA;    [UpdatedAt] = SYSUTCDATETIME()&#xA;WHERE [BatchId] = ?&#xA;  AND [BatchStatus] = 'PROCESSING';&#xA;&#xA;IF @@ROWCOUNT &lt;&gt; 1&#xA;BEGIN&#xA;    THROW 51000, 'The Aegis batch audit row could not be updated after landing.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::PackageExecutionId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::LandedRowCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::LandedRowCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::PackageExecutionId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="5"
            SQLTask:DtsVariableName="User::BatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="6"
            SQLTask:DtsVariableName="User::LandedRowCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="7"
            SQLTask:DtsVariableName="User::BatchId"
