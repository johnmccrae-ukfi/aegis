        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "VAR StartDate = DATE(2023, 1, 1)",
                "VAR EndDate   = DATE(2026, 12, 31)",
                "RETURN",
                "ADDCOLUMNS(",
                "    CALENDAR(StartDate, EndDate),",
                "    \"Date Key\", VALUE(FORMAT([Date], \"yyyymmdd\")),",
                "    \"Year\", YEAR([Date]),",
                "    \"Quarter Number\", QUARTER([Date]),",
                "    \"Quarter\", \"Q\" & FORMAT(QUARTER([Date]), \"0\"),",
                "    \"Year Quarter\",",
                "        FORMAT(YEAR([Date]), \"0000\")",
                "            & \" Q\"",
                "            & FORMAT(QUARTER([Date]), \"0\"),",
                "    \"Month Number\", MONTH([Date]),",
                "    \"Month\", FORMAT([Date], \"MMMM\"),",
                "    \"Month Short\", FORMAT([Date], \"MMM\"),",
                "    \"Year Month\",",
                "        FORMAT([Date], \"yyyy-MM\"),",
                "    \"Year Month Sort\",",
                "        YEAR([Date]) * 100 + MONTH([Date]),",
                "    \"Day\", DAY([Date]),",
                "    \"Day of Week Number\", WEEKDAY([Date], 2),",
                "    \"Day of Week\", FORMAT([Date], \"dddd\"),",
                "    \"Day of Week Short\", FORMAT([Date], \"ddd\"),",
                "    \"Is Weekend\", WEEKDAY([Date], 2) >= 6",
                ")"
              ]
            }
          }
        ],
