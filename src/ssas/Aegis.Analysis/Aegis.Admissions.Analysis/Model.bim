        ],
        "measures": [
          {
            "name": "Admissions",
            "description": "Count of accepted Admissions, evaluated using the active Admission Date relationship.",
            "expression": [
              "",
              "SUM('Fact Admission'[AdmissionCount])"
            ],
            "formatString": "0"
          },
          {
            "name": "Open Admissions",
            "description": "Count of accepted Admissions without a discharge date.",
            "expression": [
              "",
              "SUM('Fact Admission'[OpenAdmissionCount])"
            ],
            "formatString": "0"
          },
          {
            "name": "Discharged Admissions",
            "description": "Count of accepted discharged Admissions, evaluated using the inactive Discharge Date relationship.",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Fact Admission'[DischargedAdmissionCount]),",
              "    USERELATIONSHIP(",
              "        'Dim Date'[Date],",
              "        'Fact Admission'[DischargeDate]",
              "    )",
              ")"
            ],
            "formatString": "0"
          },
          {
            "name": "Distinct Patients",
            "description": "Distinct count of patients represented within the accepted Admissions dataset.",
            "expression": [
              "",
              "DISTINCTCOUNT('Fact Admission'[PatientId])"
            ],
            "formatString": "0"
          },
          {
            "name": "Average Completed Length of Stay",
            "description": "Average completed length of stay in days for discharged Admissions only.",
            "expression": [
              "",
              "AVERAGE('Fact Admission'[CompletedLengthOfStayDays])"
            ],
            "formatString": "0.00"
          },
          {
            "name": "Open Admission Percentage",
            "description": "Percentage of accepted Admissions that remain open.",
            "expression": [
              "",
              "DIVIDE(",
              "    [Open Admissions],",
              "    [Admissions]",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
